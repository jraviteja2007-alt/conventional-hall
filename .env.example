# Environment Variables Template
# Copy this file to .env and configure your secret credentials. NEVER commit .env to Git.

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DB_PATH=./data/hall.db
JWT_SECRET=cvr-convention-hall-secret-jwt-key-minimum-32-chars!
JWT_TTL_SECONDS=604800

# Payment Gateway Configuration: mock (demo/test) | razorpay (production)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications: Email (SMTP) / SMS / WhatsApp (Optional; outbox table used when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=bookings@cvrconvention.com
SMS_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=

# AI Assistant (Anthropic Claude API for natural language hall queries)
ANTHROPIC_API_KEY=

# -------------------------------------------------------------
# Staff & Admin Login Credentials
# -------------------------------------------------------------
# 1. Super Admin (Full access to all settings, users, and reports)
SEED_ADMIN_EMAIL=admin@cvrconvention.com
SEED_ADMIN_PASSWORD=Admin@12345

# 2. Hall Manager (Manage bookings, approvals, payments, calendar)
SEED_MANAGER_EMAIL=manager@hall.local
SEED_MANAGER_PASSWORD=Manager@12345

# 3. Front Desk Staff (View calendar, bookings, customer list, notes)
SEED_STAFF_EMAIL=staff@hall.local
SEED_STAFF_PASSWORD=Staff@12345

# Set to true when deploying on Render or behind reverse proxy
TRUST_PROXY=false

# Copy to .env and edit. NEVER commit .env
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DB_PATH=./data/hall.db
JWT_SECRET=change-me-to-a-long-random-string
# Payment: mock (demo only) | razorpay  (Stripe is not implemented)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Email (SMTP) / SMS / WhatsApp providers (optional; outbox logging used when empty)
SMTP_URL=
SMS_PROVIDER=
WHATSAPP_PROVIDER=
# Optional AI (Anthropic) for the assistant's natural-language layer
ANTHROPIC_API_KEY=
# Bootstrap super admin (used by seed only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@12345

# Set to true when running behind a proxy (Render, Railway, nginx)
TRUST_PROXY=false

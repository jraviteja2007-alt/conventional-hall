{
  "name": "convention-hall-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Convention hall booking & management platform. Zero dependencies: Node 22 + SQLite + vanilla JS + 3D canvas renderer.",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/api.test.js"
  }
}
